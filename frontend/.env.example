# Production Render Backend URL (Example: https://friday-backend.onrender.com)
# Local development default: http://localhost:8000
VITE_API_BASE_URL=https://YOUR-BACKEND.onrender.com

# Backend API key (must match backend API_KEY setting)
VITE_API_KEY=friday-dev-secret-key
