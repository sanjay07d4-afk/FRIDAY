# FRIDAY AI — Environment Configuration Example

# Core Settings
ENVIRONMENT=production
DEBUG=false
PORT=8000
HOST=0.0.0.0
TIMEZONE=Asia/Kolkata
FRONTEND_URL=https://your-app.vercel.app
CORS_ORIGINS=["https://your-app.vercel.app", "http://localhost:5173"]

# Security & Authentication
SECRET_KEY=friday-secure-change-in-production-random-secret-key-32-chars
API_KEY=friday-dev-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (Render SQLite default or Render PostgreSQL e.g. postgresql+asyncpg://...)
DATABASE_URL=sqlite+aiosqlite:///./friday.db

# Task Engine
MAX_CONCURRENT_TASKS=5
DEFAULT_TASK_TIMEOUT_SECONDS=60

# AI Provider Settings (Optional keys; built-in deterministic local engine works when blank)
AI_PROVIDER=local
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Voice Engine Settings
VOICE_STT_PROVIDER=mock
VOICE_TTS_PROVIDER=mock
SPEAKER_VERIFICATION_THRESHOLD=0.85

# WhatsApp & Messaging Automation
WHATSAPP_API_URL=https://graph.facebook.com/v20.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
MESSAGING_AUTO_REPLY_ENABLED=false
MESSAGING_RATE_LIMIT_PER_MINUTE=10

# Emergency Stop
EMERGENCY_STOP_ENABLED=false
